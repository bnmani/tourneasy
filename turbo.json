{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": ["NODE_ENV", "APP_URL", "NEXT_PUBLIC_*"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "AUTH_SECRET",
    "SMTP_*",
    "EMAIL_FROM",
    "SEED_*",
    "SKIP_ENV_VALIDATION",
    "CI",
    "EMAIL_TRANSPORT",
    "TEST_DATABASE_URL"
  ],
  "tasks": {
    "db:generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^db:generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^db:generate", "db:generate"]
    },
    "test": {
      "dependsOn": ["^db:generate", "db:generate"]
    }
  }
}
