// Tourneasy — Prisma schema (PostgreSQL 16)
//
// Conventions
// - UUID primary keys, createdAt/updatedAt on every mutable table.
// - Money is stored as integer cents (EUR).
// - Timestamps are stored as UTC (Prisma timestamp(3)); displayed in Europe/Amsterdam.
// - Soft delete via `deletedAt` where records are referenced historically.
// - Organiser-written, translatable content is Json: { "nl": string, "en"?: string }.
// - Partial unique indexes that Prisma cannot express are added in raw SQL migrations;
//   they are documented next to the model ("RAW SQL:").

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, btree_gist, pgcrypto]
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  PLAYER
  ORGANISER
  ADMIN
}

enum Locale {
  nl
  en
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Province {
  DRENTHE
  FLEVOLAND
  FRIESLAND
  GELDERLAND
  GRONINGEN
  LIMBURG
  NOORD_BRABANT
  NOORD_HOLLAND
  OVERIJSSEL
  UTRECHT
  ZEELAND
  ZUID_HOLLAND
  OUTSIDE_NL
}

enum ConsentType {
  TERMS
  PRIVACY_POLICY
  MARKETING_EMAIL
  PUBLIC_PROFILE
  PARENTAL_CONSENT
}

enum SessionKind {
  WEB
  MOBILE
}

enum TournamentStatus {
  DRAFT
  OPEN
  CLOSED
  IN_PROGRESS
  FINISHED
  ARCHIVED
}

/// HE = Men's singles, DE = Women's singles, HD = Men's doubles,
/// DD = Women's doubles, GD = Mixed doubles (Dutch federation codes).
enum Discipline {
  HE
  DE
  HD
  DD
  GD
}

/// Match format of an event (front-end brief: round robin, Swiss, knockout incl. double
/// elimination, hybrid = groups followed by knockout).
enum DrawType {
  KNOCKOUT
  DOUBLE_KNOCKOUT
  ROUND_ROBIN
  SWISS
  GROUPS_KNOCKOUT
  /// Each entry plays `matchesPerEntry` random opponents in the event; the best
  /// `knockoutSize` of the overall ranking play a knock-out.
  HYBRID_ROUND_ROBIN_KNOCKOUT
}

/// SELF = run by the platform admins; THIRD_PARTY = delegated to an external organiser.
enum TournamentType {
  SELF
  THIRD_PARTY
}

enum PartnerPaymentMode {
  EACH_PAYS_OWN_SHARE
  INITIATOR_PAYS_ALL
  EITHER
}

enum RefundPolicy {
  AUTOMATIC_BEFORE_DEADLINE
  ADMIN_APPROVAL
  NO_REFUNDS
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  WAITLISTED
  CANCELLED
  REFUNDED
}

enum ApprovalStatus {
  NOT_REQUIRED
  AWAITING
  APPROVED
  REJECTED
}

enum ParticipantRole {
  PRIMARY
  PARTNER
}

enum ParticipantPaymentStatus {
  UNPAID
  PAID
  PAID_BY_PARTNER
  WAIVED
  REFUNDED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum OrderStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentStatus {
  REQUIRES_PAYMENT
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELED
}

enum PaymentMethod {
  IDEAL
  CARD
  BANCONTACT
  MANUAL
  OTHER
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PENDING
  SUCCEEDED
  FAILED
}

enum DrawStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  COMPLETED
}

enum MatchStatus {
  SCHEDULED
  CALLED
  IN_PROGRESS
  COMPLETED
  WALKOVER
  RETIRED
  BYE
  CANCELLED
}

enum NotificationChannel {
  EMAIL
  PUSH
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

enum NotificationType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  MAGIC_LINK
  REGISTRATION_CONFIRMED
  REGISTRATION_WAITLISTED
  REGISTRATION_PROMOTED
  REGISTRATION_CANCELLED
  PARTNER_INVITE
  PARTNER_INVITE_RESPONSE
  PAYMENT_RECEIVED
  PAYMENT_EXPIRED
  REFUND_ISSUED
  TOURNAMENT_REMINDER
  MATCH_SCHEDULED
  MATCH_RESULT
  FOLLOWED_PLAYER_MATCH_SCHEDULED
  FOLLOWED_PLAYER_RESULT
  ANNOUNCEMENT
  ROLE_CHANGED
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity & auth
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique @db.Citext
  emailVerifiedAt  DateTime?
  passwordHash     String? // argon2id; null for magic-link-only users
  name             String
  locale           Locale    @default(nl)
  image            String? // R2 object key
  isActive         Boolean   @default(true)
  lastLoginAt      DateTime?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  anonymisedAt     DateTime? // GDPR erasure: PII scrubbed, row kept for referential integrity
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  roles               UserRole[]                @relation("UserRoles")
  rolesGranted        UserRole[]                @relation("RoleGrantedBy")
  accounts            Account[]
  sessions            UserSession[]
  passwordResetTokens PasswordResetToken[]
  consents            Consent[]
  deviceTokens        DeviceToken[]
  playerProfile       PlayerProfile?
  organiserOf         TournamentOrganiser[]
  orders              Order[]
  notifications       Notification[]
  notificationPrefs   NotificationPreference[]
  auditLogs           AuditLog[]
  refundsRequested    Refund[]                  @relation("RefundRequestedBy")
  refundsProcessed    Refund[]                  @relation("RefundProcessedBy")
  checkIns            RegistrationParticipant[] @relation("CheckedInBy")
  idempotencyKeys     IdempotencyKey[]
  following           PlayerFollow[]

  @@index([deletedAt])
}

/// A user can hold several roles. Every user gets PLAYER on sign-up.
/// Admins can grant ADMIN / ORGANISER to others (audited, last admin cannot be removed).
model UserRole {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  role        Role
  grantedById String?  @db.Uuid
  createdAt   DateTime @default(now())

  user      User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("RoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([userId, role])
  @@index([role])
}

/// Auth.js adapter table (used for magic-link / future OAuth providers).
model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// One row per signed-in device/browser. Backs "list & revoke sessions" for web and mobile.
/// Web: the Auth.js JWT carries this id and is rejected once revokedAt is set.
/// Mobile: refresh tokens rotate within this session (see RefreshToken).
model UserSession {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @db.Uuid
  kind       SessionKind
  /// WEB only: SHA-256 of the opaque session cookie value. MOBILE sessions use RefreshToken.
  tokenHash  String?     @unique
  deviceName String?
  userAgent  String?
  ipAddress  String?
  lastSeenAt DateTime    @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime    @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
}

/// Rotating refresh tokens (mobile). Only a SHA-256 hash is stored.
/// Reuse of a rotated token revokes the whole session (token family).
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  sessionId    String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime
  rotatedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  session UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

/// Auth.js verification tokens: email verification + magic links (token stored hashed).
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Versioned consent records (GDPR proof of consent). Withdrawal = new row with granted=false.
model Consent {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  type      ConsentType
  version   String // e.g. privacy policy version "2026-10"
  granted   Boolean
  grantedBy String? // for PARENTAL_CONSENT: guardian name
  ipAddress String?
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
}

model DeviceToken {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  platform   DevicePlatform
  token      String         @unique // Expo / FCM / APNs token
  lastUsedAt DateTime       @default(now())
  disabledAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// People, clubs, teams
// ─────────────────────────────────────────────────────────────────────────────

/// A player. May exist without a User (added/imported by an admin, e.g. a partner who
/// has no account yet); linked to a User when that person signs up / claims it.
model PlayerProfile {
  id                   String       @id @default(uuid()) @db.Uuid
  userId               String?      @unique @db.Uuid
  /// Platform member number, generated from a Postgres sequence, e.g. "TE100245". Login identifier.
  memberNumber         String       @unique
  /// Badminton Nederland bondsnummer (optional).
  federationId         String?      @unique
  firstName            String
  lastNamePrefix       String? // Dutch "tussenvoegsel": van, de, van der…
  lastName             String
  dateOfBirth          DateTime     @db.Date
  gender               Gender
  nationality          String?      @db.Char(2) // ISO 3166-1 alpha-2
  phone                String?
  /// Contact email for players without an account (admin-added/imported). A sign-up with
  /// this email claims the profile instead of creating a duplicate.
  contactEmail         String?      @db.Citext
  clubId               String?      @db.Uuid
  levelSinglesId       String?      @db.Uuid
  levelDoublesId       String?      @db.Uuid
  levelMixedId         String?      @db.Uuid
  photoKey             String?
  emergencyName        String?
  emergencyPhone       String?
  /// Under-16: data minimised and parental consent required (see Consent PARENTAL_CONSENT).
  isMinor              Boolean      @default(false)
  parentalConsentAt    DateTime?
  publicProfile        Boolean      @default(true) // show in public player search (public-safe fields only)
  /// Disciplines the player usually wants to enter (sign-up checkboxes; used to pre-fill entries).
  preferredDisciplines Discipline[] @default([])
  mergedIntoId         String?      @db.Uuid // set when an admin merges a duplicate into another profile
  deletedAt            DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  club         Club?           @relation(fields: [clubId], references: [id], onDelete: SetNull)
  levelSingles LevelClass?     @relation("LevelSingles", fields: [levelSinglesId], references: [id], onDelete: SetNull)
  levelDoubles LevelClass?     @relation("LevelDoubles", fields: [levelDoublesId], references: [id], onDelete: SetNull)
  levelMixed   LevelClass?     @relation("LevelMixed", fields: [levelMixedId], references: [id], onDelete: SetNull)
  mergedInto   PlayerProfile?  @relation("PlayerMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   PlayerProfile[] @relation("PlayerMerge")

  teamMemberships TeamMember[]
  participations  RegistrationParticipant[]
  invitesSent     PartnerInvite[]           @relation("InviteFrom")
  invitesReceived PartnerInvite[]           @relation("InviteTo")
  partnerRequests PartnerRequest[]
  followers       PlayerFollow[]            @relation("Followed")

  @@index([lastName, firstName])
  @@index([contactEmail])
  @@index([clubId])
  @@index([deletedAt])
}

/// "Follow a fellow participant": the follower (a User) gets notified about the
/// followed player's schedule and results.
model PlayerFollow {
  id               String   @id @default(uuid()) @db.Uuid
  followerUserId   String   @db.Uuid
  followedPlayerId String   @db.Uuid
  notify           Boolean  @default(true)
  createdAt        DateTime @default(now())

  follower User          @relation(fields: [followerUserId], references: [id], onDelete: Cascade)
  followed PlayerProfile @relation("Followed", fields: [followedPlayerId], references: [id], onDelete: Cascade)

  @@unique([followerUserId, followedPlayerId])
  @@index([followedPlayerId])
}

model Club {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  slug           String    @unique
  shortName      String?
  federationCode String?   @unique
  city           String?
  province       Province?
  website        String?
  email          String?
  logoKey        String?
  venueId        String?   @db.Uuid // home venue
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  venue   Venue?          @relation(fields: [venueId], references: [id], onDelete: SetNull)
  players PlayerProfile[]
  teams   Team[]

  @@index([name])
}

model Team {
  id        String    @id @default(uuid()) @db.Uuid
  clubId    String    @db.Uuid
  name      String
  season    String? // e.g. "2026-2027"
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  club    Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  members TeamMember[]

  @@unique([clubId, name, season])
}

model TeamMember {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @db.Uuid
  playerId  String   @db.Uuid
  isCaptain Boolean  @default(false)
  createdAt DateTime @default(now())

  team   Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([teamId, playerId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Configurable federation rules (values to be verified against Badminton Nederland regulations)
// ─────────────────────────────────────────────────────────────────────────────

/// Age category, e.g. U11…U19, SENIOR, 35+, 40+ … Age is computed on `referenceMonth/Day`
/// of the tournament's year (configurable because federation rules may change).
model AgeCategory {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique // "U13", "SENIOR", "V35"
  name           Json // { nl, en }
  minAge         Int?
  maxAge         Int?
  referenceMonth Int      @default(1)
  referenceDay   Int      @default(1)
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  events TournamentEvent[]
}

/// Playing level / class, e.g. A, B, C, D (or federation numeric levels). `rank` orders them:
/// lower rank = stronger. Events can restrict by min/max rank.
model LevelClass {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      Json // { nl, en }
  rank      Int      @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  playersSingles PlayerProfile[]   @relation("LevelSingles")
  playersDoubles PlayerProfile[]   @relation("LevelDoubles")
  playersMixed   PlayerProfile[]   @relation("LevelMixed")
  events         TournamentEvent[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Venues & tournaments
// ─────────────────────────────────────────────────────────────────────────────

model Venue {
  id                  String    @id @default(uuid()) @db.Uuid
  name                String
  slug                String    @unique
  street              String
  houseNumber         String
  postcode            String // "1234 AB"
  city                String
  province            Province
  country             String    @default("NL") @db.Char(2)
  latitude            Decimal?  @db.Decimal(9, 6)
  longitude           Decimal?  @db.Decimal(9, 6)
  numberOfCourts      Int
  facilities          Json? // { nl, en } free text or tag list
  parkingInfo         Json?
  publicTransportInfo Json?
  phone               String?
  website             String?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tournaments Tournament[]
  clubs       Club[]
  courts      Court[]

  @@index([city])
  @@index([province])
}

model Tournament {
  id                   String             @id @default(uuid()) @db.Uuid
  slug                 String             @unique
  name                 String
  description          Json? // { nl, en } (markdown)
  venueId              String?            @db.Uuid
  startsOn             DateTime           @db.Date
  endsOn               DateTime           @db.Date
  registrationOpensAt  DateTime
  registrationClosesAt DateTime
  /// Last moment entries/partner changes are accepted (may equal registrationClosesAt).
  entryDeadline        DateTime
  withdrawalDeadline   DateTime
  status               TournamentStatus   @default(DRAFT)
  type                 TournamentType     @default(SELF)
  /// First match time on each day, "HH:MM" in Europe/Amsterdam.
  dayStartTime         String?
  /// Courts available for this tournament (defaults to the venue's number of courts).
  courtsAvailable      Int?
  coverImageKey        String?
  logoKey              String?
  contactName          String?
  contactEmail         String?
  contactPhone         String?
  maxParticipants      Int?
  maxEventsPerPlayer   Int                @default(3)
  requiresApproval     Boolean            @default(false) // organiser approves entries before confirmation
  partnerPaymentMode   PartnerPaymentMode @default(EACH_PAYS_OWN_SHARE)
  refundPolicy         RefundPolicy       @default(ADMIN_APPROVAL)
  /// Percentage refunded under the automatic policy (0–100). Fee kept for admin costs.
  refundPercent        Int                @default(100)
  vatRateBasisPoints   Int                @default(0) // 2100 = 21%. Sports entries are often VAT-exempt; configurable.
  isPublished          Boolean            @default(false)
  createdById          String?            @db.Uuid
  deletedAt            DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  venue            Venue?                @relation(fields: [venueId], references: [id], onDelete: SetNull)
  organisers       TournamentOrganiser[]
  organiserInvites OrganiserInvite[]
  documents        TournamentDocument[]
  events           TournamentEvent[]
  announcements    Announcement[]
  orders           Order[]
  courtSlots       CourtSlot[]

  @@index([status, startsOn])
  @@index([startsOn])
  @@index([deletedAt])
}

/// Tournament-scoped organiser permissions.
model TournamentOrganiser {
  id               String   @id @default(uuid()) @db.Uuid
  tournamentId     String   @db.Uuid
  userId           String   @db.Uuid
  canManageEntries Boolean  @default(true)
  canManageDraws   Boolean  @default(true)
  canEnterResults  Boolean  @default(true)
  canRefund        Boolean  @default(false)
  createdAt        DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@index([userId])
}

/// Delegation to an email address without an account yet: becomes a TournamentOrganiser
/// (and the ORGANISER role) as soon as someone signs up or logs in with that email.
model OrganiserInvite {
  id           String    @id @default(uuid()) @db.Uuid
  tournamentId String    @db.Uuid
  email        String    @db.Citext
  invitedById  String?   @db.Uuid
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, email])
  @@index([email, acceptedAt])
}

model TournamentDocument {
  id           String   @id @default(uuid()) @db.Uuid
  tournamentId String   @db.Uuid
  title        Json // { nl, en }
  fileKey      String
  mimeType     String
  sizeBytes    Int
  locale       Locale?
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
}

/// An event within a tournament, e.g. "HE U17 B". Gender eligibility follows from the discipline
/// (HE/HD male, DE/DD female, GD one of each).
model TournamentEvent {
  id               String     @id @default(uuid()) @db.Uuid
  tournamentId     String     @db.Uuid
  discipline       Discipline
  ageCategoryId    String?    @db.Uuid
  levelClassId     String?    @db.Uuid
  name             Json? // optional override; otherwise generated from discipline/age/level
  feeCents         Int // per player
  maxEntries       Int? // entries = singles players or doubles pairs
  drawType         DrawType   @default(KNOCKOUT)
  groupSize        Int? // for GROUPS_KNOCKOUT
  advancePerGroup  Int?
  matchesPerEntry  Int? // HYBRID_ROUND_ROBIN_KNOCKOUT: 3, 5, 7 or 9
  knockoutSize     Int? // HYBRID_ROUND_ROBIN_KNOCKOUT: 4, 8, 16 or 32
  // Eligibility (ranks refer to LevelClass.rank; null = no limit)
  minLevelRank     Int?
  maxLevelRank     Int?
  // Scoring (BWF default: best of 3 games to 21, rally point, cap 30)
  bestOf           Int        @default(3)
  pointsToWin      Int        @default(21)
  pointsCap        Int        @default(30)
  sortOrder        Int        @default(0)
  isOpen           Boolean    @default(true)
  deletedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  tournament      Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  ageCategory     AgeCategory?     @relation(fields: [ageCategoryId], references: [id], onDelete: SetNull)
  levelClass      LevelClass?      @relation(fields: [levelClassId], references: [id], onDelete: SetNull)
  registrations   Registration[]
  partnerRequests PartnerRequest[]
  draws           Draw[]

  @@unique([tournamentId, discipline, ageCategoryId, levelClassId])
  @@index([tournamentId])
}

model Announcement {
  id           String    @id @default(uuid()) @db.Uuid
  tournamentId String?   @db.Uuid // null = site-wide news
  slug         String    @unique
  title        Json // { nl, en }
  body         Json // { nl, en } markdown
  publishedAt  DateTime?
  authorId     String?   @db.Uuid
  emailSentAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tournament Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([publishedAt])
  @@index([tournamentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Registration
// ─────────────────────────────────────────────────────────────────────────────

/// One entry in one event: a single player (singles) or a pair (doubles/mixed).
/// Capacity is counted on Registration rows with status in (PENDING, CONFIRMED).
model Registration {
  id               String             @id @default(uuid()) @db.Uuid
  eventId          String             @db.Uuid
  status           RegistrationStatus @default(PENDING)
  approval         ApprovalStatus     @default(NOT_REQUIRED)
  waitlistPosition Int?
  /// Capacity hold for unpaid entries; released by the expiry job (30 min).
  holdExpiresAt    DateTime?
  seed             Int?
  notes            String? // organiser-only
  createdById      String?            @db.Uuid
  confirmedAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  event        TournamentEvent           @relation(fields: [eventId], references: [id], onDelete: Restrict)
  participants RegistrationParticipant[]
  invites      PartnerInvite[]
  orderItems   OrderItem[]
  drawEntries  DrawEntry[]

  @@index([eventId, status])
  @@index([status, holdExpiresAt])
}

/// A player inside a registration.
/// RAW SQL: one active registration per player per event:
///   CREATE UNIQUE INDEX participant_active_unique ON "RegistrationParticipant" ("eventId","playerId")
///   WHERE "active" = true;
model RegistrationParticipant {
  id             String                   @id @default(uuid()) @db.Uuid
  registrationId String                   @db.Uuid
  eventId        String                   @db.Uuid // denormalised for the unique index above
  playerId       String                   @db.Uuid
  role           ParticipantRole
  active         Boolean                  @default(true) // false once the registration is cancelled/refunded
  paymentStatus  ParticipantPaymentStatus @default(UNPAID)
  /// QR check-in: random opaque token encoded in the QR code. Per player, so each partner can check in.
  checkInToken   String                   @unique
  checkedInAt    DateTime?
  checkedInById  String?                  @db.Uuid
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  registration Registration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  player       PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Restrict)
  checkedInBy  User?         @relation("CheckedInBy", fields: [checkedInById], references: [id], onDelete: SetNull)
  orderItems   OrderItem[]

  @@unique([registrationId, playerId])
  @@index([playerId])
  @@index([eventId, playerId])
}

/// Doubles/mixed partner invitation. Deep link: /{locale}/invites/{token}.
model PartnerInvite {
  id             String       @id @default(uuid()) @db.Uuid
  registrationId String       @db.Uuid
  fromPlayerId   String       @db.Uuid
  toPlayerId     String?      @db.Uuid // known player (by member number / email)
  toEmail        String?      @db.Citext // invite someone without an account yet
  tokenHash      String       @unique
  status         InviteStatus @default(PENDING)
  message        String?
  expiresAt      DateTime
  respondedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  registration Registration   @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  fromPlayer   PlayerProfile  @relation("InviteFrom", fields: [fromPlayerId], references: [id], onDelete: Cascade)
  toPlayer     PlayerProfile? @relation("InviteTo", fields: [toPlayerId], references: [id], onDelete: Cascade)

  @@index([toPlayerId, status])
  @@index([toEmail, status])
  @@index([registrationId])
}

/// "Looking for a partner" board per event.
model PartnerRequest {
  id        String    @id @default(uuid()) @db.Uuid
  eventId   String    @db.Uuid
  playerId  String    @db.Uuid
  note      String?
  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  event  TournamentEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  player PlayerProfile   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([eventId, playerId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Payments
// ─────────────────────────────────────────────────────────────────────────────

/// A checkout cart: one or more event fees for one tournament, paid by one user.
model Order {
  id             String      @id @default(uuid()) @db.Uuid
  orderNumber    String      @unique // human-readable, e.g. "2026-000123"
  userId         String      @db.Uuid
  tournamentId   String      @db.Uuid
  status         OrderStatus @default(PENDING)
  currency       String      @default("EUR") @db.Char(3)
  subtotalCents  Int
  vatCents       Int         @default(0)
  totalCents     Int
  expiresAt      DateTime // 30 min after creation while PENDING
  idempotencyKey String      @unique
  paidAt         DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  tournament Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  items      OrderItem[]
  payments   Payment[]
  invoice    Invoice?

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([tournamentId])
}

/// One fee line: a participant's share in a registration (or both shares when one pays for both).
model OrderItem {
  id             String   @id @default(uuid()) @db.Uuid
  orderId        String   @db.Uuid
  registrationId String   @db.Uuid
  participantId  String   @db.Uuid
  description    String
  amountCents    Int
  vatCents       Int      @default(0)
  refundedCents  Int      @default(0)
  createdAt      DateTime @default(now())

  order        Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  registration Registration            @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  participant  RegistrationParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)
  refunds      Refund[]

  @@index([orderId])
  @@index([registrationId])
  @@index([participantId])
}

/// Stripe PaymentIntent (shared by web Checkout/Payment Element and mobile Payment Sheet).
/// The webhook is the source of truth for `status`.
model Payment {
  id                      String         @id @default(uuid()) @db.Uuid
  orderId                 String         @db.Uuid
  stripePaymentIntentId   String?        @unique
  stripeCheckoutSessionId String?        @unique
  amountCents             Int
  currency                String         @default("EUR") @db.Char(3)
  status                  PaymentStatus  @default(REQUIRES_PAYMENT)
  method                  PaymentMethod?
  failureReason           String?
  succeededAt             DateTime?
  recordedById            String?        @db.Uuid // MANUAL payments marked paid by an admin
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@index([orderId])
  @@index([status, createdAt])
}

model Refund {
  id             String       @id @default(uuid()) @db.Uuid
  paymentId      String       @db.Uuid
  orderItemId    String?      @db.Uuid
  amountCents    Int
  status         RefundStatus @default(REQUESTED)
  reason         String?
  stripeRefundId String?      @unique
  requestedById  String?      @db.Uuid
  processedById  String?      @db.Uuid
  processedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  payment     Payment    @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  requestedBy User?      @relation("RefundRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  processedBy User?      @relation("RefundProcessedBy", fields: [processedById], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([status])
}

/// Receipt / invoice (PDF stored in R2). Sequential number per year, no gaps.
model Invoice {
  id       String   @id @default(uuid()) @db.Uuid
  orderId  String   @unique @db.Uuid
  number   String   @unique // "TE-2026-00001"
  pdfKey   String?
  issuedAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
}

/// Processed Stripe webhook events — makes webhook handling idempotent.
model StripeEvent {
  id          String    @id // Stripe event id (evt_…)
  type        String
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@index([type, createdAt])
}

/// Idempotency for mutating API calls (Idempotency-Key header).
model IdempotencyKey {
  id           String   @id @default(uuid()) @db.Uuid
  key          String
  userId       String   @db.Uuid
  method       String
  path         String
  requestHash  String
  responseCode Int?
  responseBody Json?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Draws, scheduling & results
// ─────────────────────────────────────────────────────────────────────────────

/// Physical courts available at a venue (reused by tournaments at that venue).
model Court {
  id        String   @id @default(uuid()) @db.Uuid
  venueId   String   @db.Uuid
  number    Int
  name      String?
  createdAt DateTime @default(now())

  venue Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  slots CourtSlot[]

  @@unique([venueId, number])
}

/// A draw for an event. GROUPS_KNOCKOUT events have one draw per group (stage=GROUP, groupNumber)
/// plus one KNOCKOUT draw for the main bracket.
model Draw {
  id          String     @id @default(uuid()) @db.Uuid
  eventId     String     @db.Uuid
  type        DrawType
  stage       String     @default("MAIN") // MAIN | GROUP | CONSOLATION
  groupNumber Int?
  name        String?
  size        Int // bracket size (power of two for knockout) or group size
  status      DrawStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  event   TournamentEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  entries DrawEntry[]
  matches Match[]

  @@index([eventId])
}

/// Placement of a registration in a draw (position in bracket / group).
model DrawEntry {
  id             String   @id @default(uuid()) @db.Uuid
  drawId         String   @db.Uuid
  registrationId String?  @db.Uuid // null = BYE
  position       Int
  seed           Int?
  createdAt      DateTime @default(now())

  draw         Draw          @relation(fields: [drawId], references: [id], onDelete: Cascade)
  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  matchesAsA   Match[]       @relation("EntryA")
  matchesAsB   Match[]       @relation("EntryB")
  matchesWon   Match[]       @relation("Winner")

  @@unique([drawId, position])
  @@unique([drawId, registrationId])
}

/// A match. Knockout winners advance into `nextMatchId` at `nextMatchSlot` (A or B).
/// Round-robin standings are computed from completed matches (not stored).
model Match {
  id                String      @id @default(uuid()) @db.Uuid
  drawId            String      @db.Uuid
  round             Int // 1 = first round; for RR the round number
  matchNumber       Int // order within the draw
  entryAId          String?     @db.Uuid
  entryBId          String?     @db.Uuid
  winnerEntryId     String?     @db.Uuid
  status            MatchStatus @default(SCHEDULED)
  nextMatchId       String?     @db.Uuid
  nextMatchSlot     String?     @db.Char(1) // "A" | "B"
  umpireName        String?
  startedAt         DateTime?
  completedAt       DateTime?
  resultEnteredById String?     @db.Uuid
  version           Int         @default(0) // optimistic locking for concurrent score entry
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  draw      Draw       @relation(fields: [drawId], references: [id], onDelete: Cascade)
  entryA    DrawEntry? @relation("EntryA", fields: [entryAId], references: [id], onDelete: SetNull)
  entryB    DrawEntry? @relation("EntryB", fields: [entryBId], references: [id], onDelete: SetNull)
  winner    DrawEntry? @relation("Winner", fields: [winnerEntryId], references: [id], onDelete: SetNull)
  nextMatch Match?     @relation("Advance", fields: [nextMatchId], references: [id], onDelete: SetNull)
  feeders   Match[]    @relation("Advance")
  sets      MatchSet[]
  slot      CourtSlot?

  @@unique([drawId, matchNumber])
  @@index([drawId, round])
  @@index([status])
}

model MatchSet {
  id        String   @id @default(uuid()) @db.Uuid
  matchId   String   @db.Uuid
  setNumber Int
  scoreA    Int
  scoreB    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, setNumber])
}

/// Court + time slot for a match within a tournament.
/// RAW SQL: prevent double-booking a court:
///   ALTER TABLE "CourtSlot" ADD CONSTRAINT court_no_overlap
///   EXCLUDE USING gist ("courtId" WITH =, tstzrange("startsAt","endsAt") WITH &&);
model CourtSlot {
  id           String   @id @default(uuid()) @db.Uuid
  tournamentId String   @db.Uuid
  courtId      String   @db.Uuid
  matchId      String?  @unique @db.Uuid
  startsAt     DateTime
  endsAt       DateTime
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  court      Court      @relation(fields: [courtId], references: [id], onDelete: Restrict)
  match      Match?     @relation(fields: [matchId], references: [id], onDelete: SetNull)

  @@index([tournamentId, startsAt])
  @@index([courtId, startsAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Notifications & audit
// ─────────────────────────────────────────────────────────────────────────────

/// One row per (recipient, channel) delivery. IN_APP rows are the user's inbox.
model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @db.Uuid
  type      NotificationType
  channel   NotificationChannel
  status    NotificationStatus  @default(QUEUED)
  locale    Locale
  /// Data for the template (ids, names); rendered per locale at send time.
  payload   Json
  /// Stable deep link path, e.g. "/registrations/{id}".
  linkPath  String?
  dedupeKey String? // avoid duplicate sends, e.g. "MATCH_RESULT:{matchId}:{userId}"
  sentAt    DateTime?
  readAt    DateTime?
  error     String?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dedupeKey, channel])
  @@index([userId, channel, readAt])
  @@index([status, createdAt])
}

model NotificationPreference {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @db.Uuid
  type      NotificationType
  channel   NotificationChannel
  enabled   Boolean             @default(true)
  updatedAt DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, channel])
}

/// Append-only log of every admin/organiser mutation (and sensitive user actions).
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String // "tournament.update", "user.role.grant", "refund.approve" …
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

/// Fixed-window rate-limit counters (login, sign-up, password reset …), shared by all app
/// instances. Expired rows are pruned opportunistically; `key` is e.g. "login:ip:1.2.3.4".
model RateLimitBucket {
  key         String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime

  @@id([key, windowStart])
  @@index([expiresAt])
}
