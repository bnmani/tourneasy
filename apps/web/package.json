{
  "name": "@tourneasy/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- next dev",
    "build": "pnpm --filter @tourneasy/db db:generate && dotenv -e ../../.env -- next build --webpack && node scripts/prepare-standalone.mjs",
    "start": "dotenv -e ../../.env -- node .next/standalone/apps/web/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.1.1",
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.3",
    "@stripe/react-stripe-js": "^7.0.1",
    "@stripe/stripe-js": "^10.2.0",
    "@tourneasy/db": "workspace:*",
    "@tourneasy/shared": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "jose": "^6.2.13",
    "jsqr": "1.4.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "next-intl": "^4.1.0",
    "nodemailer": "^10.2.1",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "stripe": "^23.0.1",
    "tailwind-merge": "^3.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "dotenv-cli": "^7.4.4",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  }
}
