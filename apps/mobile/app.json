{
  "expo": {
    "name": "Tourneasy",
    "slug": "tourneasy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tourneasy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.tourneasy.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIViewControllerBasedStatusBarAppearance": false,
        "NSCameraUsageDescription": "Tourneasy uses the camera only to scan your payment card when you pay an entry fee. Nothing is recorded or stored."
      },
      "associatedDomains": ["webcredentials:test.tourneasy.app", "webcredentials:tourneasy.com"]
    },
    "android": {
      "package": "com.tourneasy.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo-dark.png",
          "imageWidth": 240,
          "backgroundColor": "#293541"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Tourneasy uses the camera only to scan the QR code from your tournament admin."
        }
      ],
      "@sentry/react-native/expo",
      "expo-font",
      "expo-video",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Tourneasy uses Face ID to unlock the app when you turn on App lock."
        }
      ],
      "expo-sharing",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": [],
          "enableGooglePay": false,
          "disableSPM": true
        }
      ],
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a3c64b67-f8cd-4ad8-8803-56681307384a"
      }
    },
    "owner": "tourneasy"
  }
}
