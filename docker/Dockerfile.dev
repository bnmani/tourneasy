# Development image: installs deps on start so the bind-mounted source stays live.
FROM node:22-alpine

RUN apk add --no-cache libc6-compat openssl && corepack enable
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

EXPOSE 3000
CMD ["sh", "-c", "pnpm install --frozen-lockfile && pnpm db:generate && pnpm db:deploy && pnpm --filter @tourneasy/web exec next dev --turbopack -H 0.0.0.0"]
