# Copy to .env and adjust. Never commit .env.

# ── App ──────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Database (docker compose) ────────────────────────────────────────────────
DATABASE_URL="postgresql://tourneasy:tourneasy@localhost:5432/tourneasy?schema=public"

# ── Auth ─────────────────────────────────────────────────────────────────────
# Signs the mobile app's access tokens (≥ 32 chars). Generate: openssl rand -base64 48
AUTH_SECRET=""

# ── Email (Mailpit locally: UI at http://localhost:8025) ─────────────────────
# EMAIL_TRANSPORT: smtp | log | memory. Default: smtp when SMTP_HOST is set, else log
# (log prints emails, incl. links, to the server log — test environments only).
SMTP_HOST="localhost"
SMTP_PORT="1025"
# SMTP_USER=""
# SMTP_PASSWORD=""
EMAIL_FROM="Tourneasy <no-reply@tourneasy.test>"

# ── Development seed (local test accounts only) ──────────────────────────────
SEED_ADMIN_EMAIL="admin@tourneasy.test"
SEED_ADMIN_PASSWORD="Admin-dev-123!"
SEED_PLAYER_PASSWORD="Player-dev-123!"

# ── Added in later phases ────────────────────────────────────────────────────
# RESEND_API_KEY=""              # Phase 7
# STRIPE_SECRET_KEY=""           # Phase 5 (test mode key: sk_test_…)
# STRIPE_WEBHOOK_SECRET=""       # Phase 5 (from `stripe listen`)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# R2_ACCOUNT_ID=""               # Phase 2 — file uploads
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""
# SENTRY_DSN=""                  # Phase 8
